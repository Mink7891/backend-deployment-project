{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "id": 1, "title": "API requests per second", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "sum by (route) (rate(gameradar_http_requests_total{route!~\"/health|/metrics\"}[1m]))", "legendFormat": "{{route}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 2, "title": "API p95 latency", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(gameradar_http_request_duration_seconds_bucket{route!~\"/health|/metrics\"}[1m])))", "legendFormat": "{{route}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 3, "title": "HTTP 5xx error rate", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"refId": "A", "expr": "(sum(rate(gameradar_http_requests_total{status=~\"5..\",route!~\"/health|/metrics\"}[1m])) or vector(0)) / clamp_min((sum(rate(gameradar_http_requests_total{route!~\"/health|/metrics\"}[1m])) or vector(0)), 0.000001)", "legendFormat": "Server error share"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 4, "title": "PostgreSQL active connections", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"refId": "A", "expr": "pg_stat_database_numbackends{datname!~\"template.*\"}", "legendFormat": "{{datname}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 5, "title": "PostgreSQL ready (live connection)", "type": "stat",
      "description": "pg_up comes from postgres_exporter: a separate database connection every scrape, so stopping PostgreSQL changes this to 0 even when no API traffic occurs.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 16},
      "targets": [{"refId": "A", "expr": "pg_up", "instant": true}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "textMode": "auto"}
    },
    {
      "id": 6, "title": "API scrape available", "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 16},
      "targets": [{"refId": "A", "expr": "up{job=\"game-radar\"}", "instant": true}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "textMode": "auto"}
    },
    {
      "id": 7, "title": "Last API database health result", "type": "stat",
      "description": "The application gauge is updated by /health requests, including the Compose healthcheck. pg_up is the independent real-time database signal.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 16},
      "targets": [{"refId": "A", "expr": "gameradar_database_ready", "instant": true}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "textMode": "auto"}
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["game-radar", "fastapi", "postgresql"],
  "templating": {"list": []},
  "time": {"from": "now-15m", "to": "now"},
  "timezone": "browser",
  "title": "Game Radar — API and PostgreSQL",
  "uid": "game-radar",
  "version": 1
}

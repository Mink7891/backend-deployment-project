# Скопируйте в .env и замените значения. .env не коммитится (см. .gitignore).
# Остальные настройки и их значения по умолчанию — в game_radar/config.py.
POSTGRES_USER=game_radar
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=game_radar
API_KEY=replace-with-a-random-api-token-at-least-32-characters
GRAFANA_PASSWORD=replace-with-a-random-grafana-password

# mock — вымышленные цены без внешних запросов; cheapshark — реальные цены CheapShark.
PRICE_SOURCE=mock

# Copy to .env and replace every credential placeholder before running.
# .env must remain local and must never be committed.
POSTGRES_DB=game_radar
POSTGRES_USER=game_radar
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql+psycopg://game_radar:${POSTGRES_PASSWORD}@db:5432/game_radar
API_KEY=replace-with-a-random-api-token-at-least-32-characters

# mock = deterministic fictional prices with NO external network calls.
# cheapshark = real public prices in USD; cached and refreshed periodically.
PRICE_SOURCE=mock
CHEAPSHARK_BASE_URL=https://www.cheapshark.com/api/1.0
CHEAPSHARK_USER_AGENT=GameRadar-Educational/0.1
REFRESH_INTERVAL_SECONDS=3600
REFRESH_MIN_INTERVAL_SECONDS=300

# Local ports. For a private deployment LAN set APP_BIND_ADDRESS appropriately.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace-with-a-random-grafana-password

# CI writes immutable commit tags; deploy compose only pulls the image.
IMAGE_REPOSITORY=ghcr.io/your-github-owner/game-radar
IMAGE_TAG=replace-with-a-full-commit-sha
# For a separate .env.load and Compose project; set APP_PORT=8001 there.
LOAD_POSTGRES_DB=radar_load
LOAD_DATABASE_URL=postgresql+psycopg://game_radar:${POSTGRES_PASSWORD}@db:5432/radar_load

# Daily database backups; retain seven daily archives.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_COUNT=7
# An initial provisional test budget; justify or adjust after measurements.
JMETER_P95_MS=1000

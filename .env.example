# Copy to .env and replace every credential placeholder before running.
# .env must remain local and must never be committed.
POSTGRES_DB=game_radar
POSTGRES_USER=game_radar
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql+asyncpg://game_radar:${POSTGRES_PASSWORD}@db:5432/game_radar
API_KEY=replace-with-a-random-api-token-at-least-32-characters

# mock = deterministic fictional prices with NO external network calls.
# cheapshark = real public prices in USD; cached and refreshed periodically.
PRICE_SOURCE=mock
CHEAPSHARK_BASE_URL=https://www.cheapshark.com/api/1.0
CHEAPSHARK_USER_AGENT=GameRadar-Educational/0.1
REFRESH_INTERVAL_SECONDS=3600
REFRESH_MIN_INTERVAL_SECONDS=300

# Local ports. For a private deployment LAN set APP_BIND_ADDRESS appropriately.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000
